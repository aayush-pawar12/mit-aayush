---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categoryIds = Astro.url.searchParams.getAll('category').map(Number).filter((value) => !Number.isNaN(value));
const publisherId = Number(Astro.url.searchParams.get('publisher') ?? '');
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <form
      method="get"
      action="/"
      class="mb-8 rounded-2xl border border-slate-700 bg-slate-800/70 p-5 shadow-lg"
      aria-label="Game filters"
      data-testid="game-filters-form"
    >
      <div class="grid gap-6 md:grid-cols-[1.5fr_1fr_auto] md:items-end">
        <fieldset class="space-y-3" data-testid="category-filters">
          <legend class="mb-2 text-sm font-medium uppercase tracking-wide text-slate-300">Categories</legend>
          <div class="flex flex-wrap gap-3">
            {categories.map((category) => {
              const checked = categoryIds.includes(category.id);
              return (
                <label
                  for={`category-${category.id}`}
                  class={`inline-flex items-center gap-2 rounded-full border px-3 py-2 text-sm transition-colors focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none ${
                    checked ? 'border-blue-500 bg-blue-500/10 text-blue-100' : 'border-slate-600 bg-slate-900 text-slate-200'
                  }`}
                >
                  <input
                    id={`category-${category.id}`}
                    type="checkbox"
                    name="category"
                    value={category.id}
                    checked={checked}
                    class="h-4 w-4 rounded border-slate-500 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              );
            })}
          </div>
        </fieldset>

        <div class="space-y-2">
          <label for="publisher-filter" class="block text-sm font-medium uppercase tracking-wide text-slate-300">
            Publisher
          </label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="publisher-filter"
            aria-label="Filter games by publisher"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id} selected={publisherId === publisher.id}>
                {publisher.name}
              </option>
            ))}
          </select>
        </div>

        <div class="flex gap-3 md:justify-end">
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="apply-filters-button"
          >
            Apply filters
          </button>
          <a
            href="/"
            class="inline-flex items-center justify-center rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-filters-link"
          >
            Clear
          </a>
        </div>
      </div>
    </form>

    <div>
      <div class="mb-6 flex items-center justify-between gap-3">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-300" data-testid="games-summary">
          {games.length} game{games.length === 1 ? '' : 's'} shown
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>

      <div class="hidden" data-testid="empty-state">
        <p data-testid="empty-state-text" class="text-slate-300">No games match the selected filters.</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters-form"]');
  const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-testid^="category-filter-"]'));
  const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="empty-state"]');
  const summary = document.querySelector<HTMLElement>('[data-testid="games-summary"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  const params = new URLSearchParams(window.location.search);
  const initiallySelectedCategories = params.getAll('category').map(Number).filter((value) => !Number.isNaN(value) && value > 0);
  const initiallySelectedPublisher = Number(params.get('publisher') ?? '');

  if (publisherSelect && !Number.isNaN(initiallySelectedPublisher) && initiallySelectedPublisher > 0) {
    const matchingPublisherOption = Array.from(publisherSelect.options).some(
      (option: HTMLOptionElement) => Number(option.value) === initiallySelectedPublisher,
    );
    if (matchingPublisherOption) {
      publisherSelect.value = String(initiallySelectedPublisher);
    }
  }

  categoryInputs.forEach((input) => {
    input.checked = initiallySelectedCategories.includes(Number(input.value));
  });

  function updateSummary(visibleCount: number) {
    if (summary) {
      summary.textContent = `${visibleCount} game${visibleCount === 1 ? '' : 's'} shown`;
    }
  }

  function getSelectedCategories(): number[] {
    const checkedValues = categoryInputs
      .filter((input) => input.checked)
      .map((input) => Number(input.value));

    if (checkedValues.length > 0) {
      return checkedValues;
    }

    return params.getAll('category').map(Number).filter((value) => !Number.isNaN(value) && value > 0);
  }

  function getSelectedPublisher(): number | null {
    const selectedValue = publisherSelect && publisherSelect.value ? Number(publisherSelect.value) : null;
    if (selectedValue !== null && selectedValue > 0) {
      return selectedValue;
    }

    const rawPublisherValue = Number(params.get('publisher') ?? '');
    return !Number.isNaN(rawPublisherValue) && rawPublisherValue > 0 ? rawPublisherValue : null;
  }

  function applyFilters() {
    const selectedCategories = getSelectedCategories();
    const selectedPublisher = getSelectedPublisher();
    let visibleCount = 0;

    cards.forEach((card) => {
      const cardCategory = Number(card.dataset.categoryId || '0');
      const cardPublisher = Number(card.dataset.publisherId || '0');
      const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(cardCategory);
      const matchesPublisher = selectedPublisher === null || selectedPublisher === cardPublisher;
      const isVisible = matchesCategory && matchesPublisher;
      card.style.display = isVisible ? '' : 'none';
      if (isVisible) {
        visibleCount += 1;
      }
    });

    if (gamesGrid) {
      gamesGrid.classList.toggle('hidden', visibleCount === 0);
    }
    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCount !== 0);
    }
    updateSummary(visibleCount);

    const nextParams = new URLSearchParams(window.location.search);
    nextParams.delete('category');
    nextParams.delete('publisher');

    selectedCategories.forEach((categoryId) => nextParams.append('category', String(categoryId)));
    if (selectedPublisher !== null) {
      nextParams.set('publisher', String(selectedPublisher));
    }

    const nextUrl = `${window.location.pathname}${nextParams.toString() ? `?${nextParams.toString()}` : ''}`;
    window.history.replaceState({}, '', nextUrl);
  }

  if (form) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });
  }

  categoryInputs.forEach((input) => {
    input.addEventListener('change', applyFilters);
  });

  if (publisherSelect) {
    publisherSelect.addEventListener('change', applyFilters);
  }

  applyFilters();
</script>
